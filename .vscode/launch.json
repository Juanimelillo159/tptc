{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "App",
            "request": "launch",
            "mainClass": "tptc.App",
            "projectName": "tptc"
        },
        {
            "type": "java",
            "name": "AnalizadorLexico",
            "request": "launch",
            "mainClass": "tptc.AnalizadorLexico",
            "projectName": "tptc"
        },
        {
            "name": "Debug ANTLR4 grammar",
            "type": "antlr-debug",
            "request": "launch",
            "grammar": "${file}",
            "input": "input/programa.txt",
            "startRule": "programa",
            "printParseTree": true,
            "visualParseTree": true
        },
        {
            "type": "java",
            "name": "Launch Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Launch App",
            "request": "launch",
            "mainClass": "tptc.App",
            "projectName": "proyectobase"
        }
    ]
}